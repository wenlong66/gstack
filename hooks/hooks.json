{
  "hooks": {
    "PostToolUse": [
      {
        "_gstack_source": "plan-tune-cathedral",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hosts/claude/hooks/question-log-hook",
            "timeout": 5
          }
        ],
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)"
      }
    ],
    "PreToolUse": [
      {
        "_gstack_source": "plan-tune-cathedral",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hosts/claude/hooks/question-preference-hook",
            "timeout": 5
          }
        ],
        "matcher": "(AskUserQuestion|mcp__.*__AskUserQuestion)"
      }
    ]
  }
}
